import random
import time

# Partition function
def partition(arr, low, high, count):
    pivot = arr[high]
    i = low - 1

    for j in range(low, high):
        count[0] += 1

        if arr[j] <= pivot:
            i += 1
            arr[i], arr[j] = arr[j], arr[i]

    arr[i + 1], arr[high] = arr[high], arr[i + 1]

    return i + 1


# Deterministic Quick Sort
def deterministic_quick_sort(arr, low, high, count):
    if low < high:
        pi = partition(arr, low, high, count)

        deterministic_quick_sort(arr, low, pi - 1, count)
        deterministic_quick_sort(arr, pi + 1, high, count)


# Randomized Quick Sort
def randomized_quick_sort(arr, low, high, count):
    if low < high:

        # Select random pivot
        random_index = random.randint(low, high)

        # Move random pivot to the last position
        arr[random_index], arr[high] = arr[high], arr[random_index]

        pi = partition(arr, low, high, count)

        randomized_quick_sort(arr, low, pi - 1, count)
        randomized_quick_sort(arr, pi + 1, high, count)


# Main Program
arr = list(map(int, input("Enter array elements: ").split()))

# Deterministic Quick Sort
arr1 = arr.copy()
count1 = [0]

start = time.perf_counter()

deterministic_quick_sort(arr1, 0, len(arr1) - 1, count1)

time1 = time.perf_counter() - start

# Randomized Quick Sort
arr2 = arr.copy()
count2 = [0]

start = time.perf_counter()

randomized_quick_sort(arr2, 0, len(arr2) - 1, count2)

time2 = time.perf_counter() - start


# Display Results
print("\n----- QUICK SORT ANALYSIS -----")

print("\nDeterministic Quick Sort:")
print("Sorted Array:", arr1)
print("Number of Comparisons:", count1[0])
print("Execution Time:", time1, "seconds")

print("\nRandomized Quick Sort:")
print("Sorted Array:", arr2)
print("Number of Comparisons:", count2[0])
print("Execution Time:", time2, "seconds")

A. Deterministic Quick Sort
Select the last element as the pivot.
Compare all other elements with the pivot.
Place smaller elements on the left and larger elements on the right.
Place the pivot in its correct position.
Recursively sort the left and right subarrays.

B. Randomized Quick Sort
Select a random element as the pivot.
Move the selected pivot to the last position.
Partition the array.
Place the pivot in its correct position.
Recursively sort the left and right subarrays.
Repeat until the entire array is sorted.

