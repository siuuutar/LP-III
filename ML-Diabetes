# Assignment 11: Diabetes Prediction using KNN and Random Forest

# 1. Import libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.neighbors import KNeighborsClassifier
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import confusion_matrix, accuracy_score
from sklearn.metrics import precision_score, recall_score
from sklearn.metrics import mean_squared_error, r2_score
from sklearn.metrics import roc_auc_score, roc_curve

# 2. Load dataset
df = pd.read_csv("diabetes.csv")

print("Dataset:")
print(df.head())

print("\nDataset Shape:", df.shape)
print("\nMissing Values:")
print(df.isnull().sum())

print("\nOutcome Count:")
print(df["Outcome"].value_counts())


# 3. Handle zero values
# Zero values in these columns may represent missing readings
columns = ["Glucose", "BloodPressure", "SkinThickness", "Insulin", "BMI"]

for col in columns:
    df[col] = df[col].replace(0, np.nan)

# Separate input and output
X = df.drop("Outcome", axis=1)
y = df["Outcome"]


# 4. Identify outliers using IQR
print("\nOutliers in each column:")

for col in X.columns:
    Q1 = X[col].quantile(0.25)
    Q3 = X[col].quantile(0.75)
    IQR = Q3 - Q1

    outliers = X[(X[col] < Q1 - 1.5 * IQR) |
                 (X[col] > Q3 + 1.5 * IQR)]

    print(col, ":", len(outliers))


# 5. Display correlation heatmap
plt.figure(figsize=(10, 6))
sns.heatmap(df.corr(), annot=True, cmap="coolwarm")
plt.title("Correlation Heatmap")
plt.show()


# 6. Split dataset into training and testing data
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.20, random_state=1, stratify=y
)


# 7. Fill missing values using training data median
for col in columns:
    median = X_train[col].median()

    X_train[col] = X_train[col].fillna(median)
    X_test[col] = X_test[col].fillna(median)


# 8. Standardize data for KNN
scaler = StandardScaler()

X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)


# 9. Apply KNN Classification
knn = KNeighborsClassifier(n_neighbors=3)
knn.fit(X_train_scaled, y_train)

knn_pred = knn.predict(X_test_scaled)
knn_prob = knn.predict_proba(X_test_scaled)[:, 1]

print("\n========== KNN RESULTS ==========")
print("Confusion Matrix:\n", confusion_matrix(y_test, knn_pred))
print("Accuracy:", accuracy_score(y_test, knn_pred))
print("Precision:", precision_score(y_test, knn_pred))
print("Recall:", recall_score(y_test, knn_pred))
print("Mean Squared Error:", mean_squared_error(y_test, knn_pred))
print("R2 Score:", r2_score(y_test, knn_pred))
print("ROC-AUC Score:", roc_auc_score(y_test, knn_prob))


# 10. Apply Random Forest Classification
rf = RandomForestClassifier(n_estimators=100, random_state=1)
rf.fit(X_train, y_train)

rf_pred = rf.predict(X_test)
rf_prob = rf.predict_proba(X_test)[:, 1]

print("\n========== RANDOM FOREST RESULTS ==========")
print("Confusion Matrix:\n", confusion_matrix(y_test, rf_pred))
print("Accuracy:", accuracy_score(y_test, rf_pred))
print("Precision:", precision_score(y_test, rf_pred))
print("Recall:", recall_score(y_test, rf_pred))
print("Mean Squared Error:", mean_squared_error(y_test, rf_pred))
print("R2 Score:", r2_score(y_test, rf_pred))
print("ROC-AUC Score:", roc_auc_score(y_test, rf_prob))

#  Confusion Matrix Images for Both Models

knn_cm = confusion_matrix(y_test, knn_pred)
rf_cm = confusion_matrix(y_test, rf_pred)

plt.figure(figsize=(12, 5))

# KNN Confusion Matrix
plt.subplot(1, 2, 1)
sns.heatmap(knn_cm, annot=True, fmt="d", cmap="Blues",
            xticklabels=["No Diabetes", "Diabetes"],
            yticklabels=["No Diabetes", "Diabetes"])
plt.title("KNN Confusion Matrix")
plt.xlabel("Predicted")
plt.ylabel("Actual")

# Random Forest Confusion Matrix
plt.subplot(1, 2, 2)
sns.heatmap(rf_cm, annot=True, fmt="d", cmap="Greens",
            xticklabels=["No Diabetes", "Diabetes"],
            yticklabels=["No Diabetes", "Diabetes"])
plt.title("Random Forest Confusion Matrix")
plt.xlabel("Predicted")
plt.ylabel("Actual")

plt.tight_layout()
plt.show()

# 11. Plot ROC Curves
knn_fpr, knn_tpr, _ = roc_curve(y_test, knn_prob)
rf_fpr, rf_tpr, _ = roc_curve(y_test, rf_prob)

plt.figure(figsize=(7, 5))
plt.plot(knn_fpr, knn_tpr, label="KNN")
plt.plot(rf_fpr, rf_tpr, label="Random Forest")
plt.plot([0, 1], [0, 1], linestyle="--")

plt.xlabel("False Positive Rate")
plt.ylabel("True Positive Rate")
plt.title("ROC Curve")
plt.legend()
plt.show()


# 12. Compare model accuracy
print("\n========== MODEL COMPARISON ==========")
print("KNN Accuracy:", accuracy_score(y_test, knn_pred))
print("Random Forest Accuracy:", accuracy_score(y_test, rf_pred))

if accuracy_score(y_test, knn_pred) > accuracy_score(y_test, rf_pred):
    print("KNN performs better.")
else:
    print("Random Forest performs better.")

Q1. What is a Confusion Matrix?
A confusion matrix is a table used to evaluate a classification model by comparing actual and predicted values.
It contains four values:
True Positive (TP)
True Negative (TN)
False Positive (FP)
False Negative (FN)

Q2. Define Accuracy.
Accuracy is the ratio of correctly predicted observations to the total observations.
\[ Accuracy=\frac{TP+TN}{TP+TN+FP+FN} \]

Q3. Define Error Rate.
Error rate is the ratio of incorrectly predicted observations to the total observations.
\[ Error\ Rate=\frac{FP+FN}{TP+TN+FP+FN} \]

Q4. Define Precision.
Precision measures how many predicted positive cases are actually positive.
\[ Precision=\frac{TP}{TP+FP} \]

Q5. Define Recall.
Recall measures how many actual positive cases are correctly identified by the model.
\[ Recall=\frac{TP}{TP+FN} \]

3. Viva Questions and Answers
Q1. What is Machine Learning?
Machine Learning is a branch of Artificial Intelligence that enables computers to learn from data and make predictions without being explicitly programmed for every task.

Q2. What is supervised learning?
Supervised learning is a type of machine learning in which a model is trained using labelled data.

Q3. What is classification?
Classification is a supervised learning technique used to predict categorical output classes.

Q4. What is the objective of this assignment?
The objective is to predict whether a person has diabetes using medical attributes and evaluate the performance of classification models.

Q5. What is KNN?
K-Nearest Neighbors is a supervised machine learning algorithm that classifies a data point based on the majority class of its nearest K neighbors.

Q6. How does the KNN algorithm work?
Select the value of K.
Calculate the distance between data points.
Find the K nearest neighbors.
Identify their classes.
Assign the majority class to the new data point.

Q7. What is the role of K in KNN?
K represents the number of nearest neighbors considered for classification.

Q8. What happens when K is too small?
The model may become sensitive to noise and overfit the training data.

Q9. What happens when K is too large?
The model may become too generalized and underfit the data.

Q10. Which distance metric is commonly used in KNN?
Euclidean distance.
\[ d=\sqrt{\sum_{i=1}^{n}(x_i-y_i)^2} \]

Q11. Why is feature scaling required in KNN?
KNN uses distance calculations. Scaling ensures that features with larger numerical values do not dominate the distance calculation.

Q12. What is Standardization?
Standardization transforms data so that it has approximately zero mean and unit standard deviation.

Q13. What is the purpose of train-test splitting?
It divides the dataset into training and testing portions. The training set is used to train the model, while the testing set evaluates its performance on unseen data.

Q14. What is Random Forest?
Random Forest is an ensemble learning algorithm that combines multiple decision trees to improve prediction performance.

Q15. How does Random Forest make predictions?
It combines the predictions of multiple decision trees. For classification, the final result is generally decided through majority voting.

Q16. What is the difference between KNN and Random Forest?
KNN predicts using nearby data points, whereas Random Forest combines predictions from multiple decision trees.

Q17. What is the target variable in the diabetes dataset?
The target variable is Outcome.
0 – Person does not have diabetes.
1 – Person has diabetes.

Q18. What is data preprocessing?
Data preprocessing is the process of cleaning and preparing raw data before applying machine learning algorithms.

Q19. Why do we handle zero values in the diabetes dataset?
Zero values in features such as Glucose, BloodPressure, Insulin and BMI may represent missing medical readings. We replace these values with the median to avoid treating them as genuine measurements.

Q20. What is overfitting?
Overfitting occurs when a model performs well on training data but poorly on unseen testing data.

Q21. What is underfitting?
Underfitting occurs when a model is too simple to learn the patterns in the training data.

Q22. What is ROC Curve?
ROC stands for Receiver Operating Characteristic. It is a graph that plots True Positive Rate against False Positive Rate at different classification thresholds.

Q23. What is ROC-AUC?
AUC stands for Area Under the Curve. It measures how well a classification model distinguishes between two classes.

Q24. What is F1-score?
F1-score is the harmonic mean of precision and recall.
\[ F1=2\times\frac{Precision\times Recall}{Precision+Recall} \]
