import heapq

# Node class for Huffman Tree
class Node:
    def __init__(self, char, freq):
        self.char = char
        self.freq = freq
        self.left = None
        self.right = None

    def __lt__(self, other):
        return self.freq < other.freq


# Generate Huffman Codes
def generate_codes(root, code, huffman_codes):
    if root is None:
        return

    # Leaf node
    if root.char is not None:
        huffman_codes[root.char] = code if code else "0"
        return

    generate_codes(root.left, code + "0", huffman_codes)
    generate_codes(root.right, code + "1", huffman_codes)


# Huffman Encoding Function
def huffman_encoding(text):
    frequency = {}

    # Calculate frequency of each character
    for char in text:
        frequency[char] = frequency.get(char, 0) + 1

    # Create priority queue
    heap = []

    for char, freq in frequency.items():
        heapq.heappush(heap, Node(char, freq))

    # Build Huffman Tree
    while len(heap) > 1:
        left = heapq.heappop(heap)
        right = heapq.heappop(heap)

        new_node = Node(None, left.freq + right.freq)
        new_node.left = left
        new_node.right = right

        heapq.heappush(heap, new_node)

    # Generate Huffman Codes
    root = heap[0]
    huffman_codes = {}
    generate_codes(root, "", huffman_codes)

    # Display Huffman Table
    print("\nHuffman Encoding Table")
    print("-" * 45)
    print("{:<12} {:<12} {:<15}".format(
        "Character", "Frequency", "Huffman Code"))
    print("-" * 45)

    total_bits = 0

    for char in sorted(frequency):
        code = huffman_codes[char]
        bits = frequency[char] * len(code)
        total_bits += bits

        display_char = "' '" if char == " " else char

        print("{:<12} {:<12} {:<15}".format(
            display_char, frequency[char], code))

    print("-" * 45)
    print("Total Bits Required:", total_bits)

    # Display encoded string
    encoded_text = ''.join(huffman_codes[ch] for ch in text)

    print("\nOriginal Text:", text)
    print("Encoded Text:", encoded_text)


# Main Program
text = input("Enter the text: ")

if text:
    huffman_encoding(text)
else:
    print("Please enter a valid text.")

